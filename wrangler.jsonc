{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restoration-notes",
  "compatibility_date": "2026-11-08",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  // Serves https://notes.rfclakeland.com (custom domain attached in Cloudflare) and the workers.dev alias.
  "vars": {
    "APP_ORIGIN": "https://notes.rfclakeland.com",
    "APP_ORIGIN_ALIASES": "https://restoration-notes.media-ff8.workers.dev",
    "AUTH_FROM_ADDRESS": "media@rfclakeland.com",
  },
  "send_email": [{ "name": "AUTH_MAILER", "allowed_sender_addresses": ["media@rfclakeland.com"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restoration-notes-preview",
      "database_id": "bfbe2a90-1652-4e8f-9034-8b75e7d82377",
      "migrations_dir": "migrations",
    },
    {
      // Shared RFC identity store (platform_* tables only). Owner approved Nov 22, 2026.
      // No migrations_dir: this app never runs migrations against rfc-church.
      "binding": "AUTH_DB",
      "database_name": "rfc-church",
      "database_id": "3ff6d525-273f-4ce0-9fa2-fc5ddd745483",
    },
  ],
  "r2_buckets": [
    {
      "binding": "COVERS",
      "bucket_name": "restoration-notes-preview-covers",
    },
  ],
}
